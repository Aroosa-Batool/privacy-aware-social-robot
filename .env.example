# Copy to .env (git-ignored) for machine-specific settings. Any setting can be set this way:
# PASR__<GROUP>__<FIELD>=value, nested with "__". Lists use YAML: PASR__SCAN__POSITIONS=[left, right]

# PASR__HARDWARE__OHBOT__PORT=/dev/cu.usbmodem101
# PASR__HARDWARE__SPEAKER__OUTPUT_DEVICE="MacBook Air Speakers"
# PASR__HARDWARE__CAMERA__INDEX=0
# PASR__HARDWARE__MICROPHONE__DEVICE="MacBook Air Microphone"
# PASR__HARDWARE__MICROPHONE__SOURCE=wav
# PASR__HARDWARE__MICROPHONE__WAV_PATH=~/experiments/session.wav
# PASR__HARDWARE__CAMERA__SOURCE=images
# PASR__HARDWARE__CAMERA__IMAGE_DIR=~/experiments/frames
# PASR__STORAGE__DATA_DIR=data
# PASR__STORAGE__MODELS_DIR=models
