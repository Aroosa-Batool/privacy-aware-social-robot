   <row>
    <id><![CDATA[34113]]></id>
    <gid><![CDATA[35469]]></gid>
    <group_name><![CDATA[Technology Experience]]></group_name>
    <description/>
    <language><![CDATA[en]]></language>
    <sid><![CDATA[841423]]></sid>
    <group_order><![CDATA[2]]></group_order>
    <randomization_group/>
